# Copy to deploy/.env and replace every /absolute/path placeholder.
CODEXBOT_BIND_ADDRESS=127.0.0.1
CODEXBOT_PORT=8080
CODEXBOT_SECURE_COOKIES=false
TZ=Asia/Tokyo

# `id -u` normally identifies the rootless socket path.
CODEXBOT_DOCKER_SOCKET=/run/user/1000/docker.sock
CODEXBOT_SHARED_HOME=/absolute/path/to/codexbot/shared-home

CODEXBOT_RUNTIME_TOKEN_FILE=./secrets/runtime-token
CODEXBOT_BOOTSTRAP_TOKEN_FILE=./secrets/bootstrap-token

CODEXBOT_AGENT_IMAGE=codexbot-agent:local
CODEXBOT_EGRESS_IMAGE=codexbot-egress:local
CODEXBOT_EGRESS_NETWORK=codexbot-egress

# Keep false unless intentionally using a rootful socket. The same value must
# be present when running prepare-host.sh.
CODEXBOT_ALLOW_ROOTFUL_DOCKER=false
