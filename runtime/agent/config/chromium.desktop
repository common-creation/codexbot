[Desktop Entry]
Version=1.0
Name=Chromium
Comment=Browse the Web in the agent-visible Chromium session
GenericName=Web Browser
Exec=/usr/local/lib/codexbot/chromium-visible %U
Terminal=false
Type=Application
Icon=chromium
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true

